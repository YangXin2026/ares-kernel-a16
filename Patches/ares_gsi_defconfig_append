# ares (Redmi K40 Gaming / MT6893 / arm64 / 4.14.336) defconfig append
# Target: Android 16 GSI, feature-rich but conflict-free.
# Deduplicated against baseline ares_defconfig and against:
#   ares_user_defconfig_append, ares_gaming_defconfig_append, ares_boost_defconfig_append
# Every symbol below was checked against this tree's Kconfig sources.
# ASCII only, one symbol per line, no inline comments.

# ===== 1. IKCONFIG / module loading =====
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_MODULE_FORCE_LOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y

# ===== 2. BPF core (GSI requirement + eBPF speed) =====
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y

# ===== 3. Memory compression backends =====
CONFIG_ZSTD_DECOMPRESS=y
CONFIG_LZ4_DECOMPRESS=y

# ===== 4. Filesystem: images, external media, fscrypt/fsverity =====
CONFIG_FS_ENCRYPTION=y
CONFIG_F2FS_FS_ENCRYPTION=y
CONFIG_FS_VERITY=y
CONFIG_F2FS_FS_ZSTD=y
CONFIG_F2FS_FS_LZO=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_PCPU_KTHREAD_HIPRI=y
CONFIG_UDF_FS=y
CONFIG_UDF_NLS=y
CONFIG_NLS_CODEPAGE_936=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y

# ===== 5. Network: packet schedulers and classifiers =====
