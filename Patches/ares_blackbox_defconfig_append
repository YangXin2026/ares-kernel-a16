# ares 黑匣子批次 —— 让"没起来"这件事留下证据
# 背景：官方 A13 靶场上刷外来内核时会直接落到 fastboot，内核日志拿不到（/proc/last_kmsg 只有 2KB SRAM 头，
#       pstore 为空），排查全靠猜。MTK 平台自带两个真正的黑匣子：
#         1) AEE (Android Exception Enhancement)：panic 时把日志/现场写进 expdb 分区，重启后还在
#         2) PSTORE/ramoops：通用持久化存储
# 这些配置只增加"记录能力"，不改任何调优行为，所以对所有变体都开。

# ===== 1. MTK AEE（原生黑匣子：panic -> expdb 分区）=====
CONFIG_MTK_AEE_FEATURE=y
CONFIG_MTK_AEE_AED=y
CONFIG_MTK_AEE_IPANIC=y
CONFIG_MTK_AEE_HANG_DETECT=y

# ===== 2. PSTORE / ramoops（通用持久化内核日志）=====
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# ===== 3. panic 后自动重启（否则设备挂在黑屏上，我们连 adb 都拿不到）=====
CONFIG_PANIC_TIMEOUT=10

# ===== 4. 常用可观测性 =====
CONFIG_MAGIC_SYSRQ=y
CONFIG_DEBUG_FS=y
CONFIG_PROC_KCORE=y
CONFIG_SCHED_DEBUG=y

# ===== 5. MTK 连接子系统（必须补齐，否则 WiFi 驱动报 Unsuppoted HIF 直接 Stop）=====
# 树内 ares_defconfig 本来有 CONFIG_MTK_COMBO=y；但从"已验证配置"（抠出来的完整 .config）起底时
# 这一项缺失，导致 gen4m/Makefile 拿到空的 HIF 值而报错。这里统一补齐，两种起底方式都安全。
CONFIG_MTK_COMBO=y
CONFIG_MTK_COMBO_WIFI=y
CONFIG_MTK_COMBO_BT=y
CONFIG_MTK_COMBO_GPS=y
CONFIG_MTK_COMBO_CHIP="CONSYS_6893"
CONFIG_MTK_COMBO_CHIP_CONSYS_6893=y
CONFIG_MTK_COMBO_WIFI_HIF="axi"
